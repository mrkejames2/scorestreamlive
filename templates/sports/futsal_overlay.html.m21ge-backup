<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>ScoreStreamLive | Futsal Broadcast Overlay</title>
<link rel="stylesheet" href="/static/css/futsal-overlay-m21d.css?v=m21d-1"></head>
<body data-game-id="{{ game_id }}"><main class="canvas" aria-label="Futsal broadcast overlay">
<section class="scoreboard" id="scoreboard">
<div class="team home"><div class="identity"><div class="logo-wrap"><img id="home-logo" hidden alt=""><span id="home-initial">H</span></div><div class="team-info"><span class="side">HOME</span><span id="home-name" class="name">HOME</span></div></div><strong id="home-score" class="score">0</strong></div>
<div class="center"><span class="sport">FUTSAL</span><span id="clock" class="clock">--:--</span><span id="period" class="period">PREGAME</span></div>
<div class="team away"><strong id="away-score" class="score">0</strong><div class="identity"><div class="team-info"><span class="side">AWAY</span><span id="away-name" class="name">AWAY</span></div><div class="logo-wrap"><img id="away-logo" hidden alt=""><span id="away-initial">A</span></div></div></div>
</section><aside class="sponsor" id="sponsor" hidden><img id="sponsor-logo" alt="Sponsor"><span id="sponsor-label">SPONSOR</span></aside>
<div id="connection" class="connection" aria-live="polite">Connecting…</div>
</main><script src="/static/js/sports/futsal_overlay_m21d.js?v=m21d-1" defer></script></body></html>
