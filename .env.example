APP_NAME=ScoreStreamLive
APP_ENV=development
APP_VERSION=0.5.0
# M17-I exact deployment identity. Render uses RENDER_GIT_COMMIT automatically.
# Set APP_RELEASE explicitly for local or alternate deployments when desired.
APP_RELEASE=local-dev
LOG_LEVEL=INFO

DB_HOST=postgres
DB_PORT=5432
DB_NAME=scorestreamlive
DB_USER=scorestreamlive
DB_PASSWORD=[set4now]

SOCKET_CORS_ORIGINS=*
# M17-D invitation/email delivery
PUBLIC_BASE_URL=http://localhost:8000
INVITATION_TTL_HOURS=72
# M17-E account recovery
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_RESEND_SECONDS=60
EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=ScoreStreamLive
